# Gateway de Magnus Cloud (saldo de créditos delante de vLLM).
#
# No usa GPU: la inferencia la hace el contenedor de vLLM. Corre en x86 y arm64
# (B200, DGX Spark, Jetson, PC con RTX), así que basta una base Python ligera.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MAGNUS_GATEWAY_DB=/data/ledger.db \
    MAGNUS_GATEWAY_CONFIG=/config/models.json

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY cloud ./cloud

EXPOSE 8430
CMD ["uvicorn", "cloud.gateway:app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8430"]
